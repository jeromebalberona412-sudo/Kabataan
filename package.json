        "http-proxy": "^1.18.1",
        "laravel-vite-plugin": "^2.0.0",
        "selfsigned": "^2.4.1",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "bootstrap": "^5.3.8",
        "pdfjs-dist": "^6.0.227",
        "signature_pad": "^5.1.3"
    },
    "allowScripts": {
        "esbuild@0.28.1": true
    }
}
