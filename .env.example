APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Public URL for email verification/password links (must be reachable from phone).
# Example: https://your-domain.com or http://192.168.1.50:8002 on same Wi-Fi
APP_PUBLIC_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_TIMEOUT=120
SESSION_TIMEOUT_WARNING_MINUTES=5
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_COOKIE=kabataan_session
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SK Officials App URL (for community feed link)
SK_OFFICIALS_APP_URL=http://localhost:8000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sk_oneportal/kabataan_posts
CLOUDINARY_PROFILE_UPLOAD_PRESET=kabataan_profile_images
CLOUDINARY_PROFILE_FOLDER=kabataan_profile_images
CLOUDINARY_SUPPORTING_DOCS_UPLOAD_PRESET=Supporting_Documents
CLOUDINARY_SUPPORTING_DOCS_FOLDER=Supporting_Documents
CLOUDINARY_COMMUNICATION_FOLDER=communication
CLOUDINARY_COMMUNICATION_UPLOAD_PRESET=

# PaddleOCR (KK Profiling — PhilSys, PhilHealth, Voter's ID)
OCR_ROOT=
OCR_PYTHON_PATH=
OCR_API_URL=http://127.0.0.1:8001
OCR_API_ENABLED=true
OCR_API_KEY=
OCR_TIMEOUT=120
OCR_MIN_CONFIDENCE=0.45
OCR_MIN_DETECT_CONFIDENCE=0.35
OCR_PIPELINE_ENABLED=true
OCR_PIPELINE_TIMEOUT=600

# Cloudflare Turnstile Configuration
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# Require Turnstile on first protected action, then again after N consecutive failures/requests
AUTH_TURNSTILE_FAILED_ATTEMPTS=3
AUTH_TURNSTILE_STATE_TTL=3600
TESSERACT_PATH="C:\Program Files\Tesseract-OCR\tesseract.exe"
TESSERACT_LANG=eng
TESSERACT_PSM_MODES=6,11,12
OCR_DIAGNOSTICS_ENABLED=false

# Communications (Supabase Realtime + Storage) — never expose SERVICE_ROLE_KEY to Vite/browser
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_COMMUNICATION_BUCKET=communication
COMMUNICATIONS_IMAGE_MAX_KB=5120
COMMUNICATIONS_FILE_MAX_KB=10240
COMMUNICATIONS_ALLOW_SVG=false
